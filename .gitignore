.DS_Store
*.log
/tmp/
node_modules/
# Python bytecode caches (generated when running bootstrap/ tests)
__pycache__/
*.py[cod]
# scratch HOME used for install dry-runs
/.scratch-home/
# settings backups produced by install.sh (if ever run inside the repo)
settings.json.bak.*
# skill-development eval fixtures must not ship (contain machine paths, not runtime resources)
plugins/*/skills/*/evals/
# Runtime/account state must never be committed (CLAUDE.md invariant 4,
# docs/architecture.md three-bucket model). Anchored to the repo root: these are
# top-level ~/.claude account-state paths, so root-anchoring avoids clobbering
# the tracked docs/superpowers/plans/ directory.
/history.jsonl
/projects/
/sessions/
/daemon*
/telemetry/
/ide/
/shell-snapshots/
/file-history/
/plans/
/tasks/
